{
  "schema_version": 1,
  "actions": [
    {
      "name": "actions.list",
      "description": "List all available actions with name, description, category, and permission",
      "category": "catalog",
      "permission": "read",
      "input_schema": {},
      "output_schema": {
        "data": {
          "type": "array",
          "items": {
            "name": "string",
            "description": "string",
            "category": "string",
            "permission": "string"
          }
        }
      }
    },
    {
      "name": "actions.describe",
      "description": "Describe a specific action's full schema, input, output, and permission",
      "category": "catalog",
      "permission": "read",
      "input_schema": {
        "action": {
          "type": "string",
          "required": true,
          "description": "The action name to describe"
        }
      },
      "output_schema": {
        "data": {
          "type": "object",
          "description": "Full action definition"
        }
      }
    },
    {
      "name": "team.list",
      "description": "List all active teams from manifest storage",
      "category": "team",
      "permission": "read",
      "input_schema": {},
      "output_schema": {
        "data": {
          "type": "array",
          "items": {
            "team_id": "string",
            "workspace_id": "string",
            "members": "array",
            "created_at": "string",
            "status": "string"
          }
        }
      }
    },
    {
      "name": "team.start",
      "description": "Preflight, config validation, pane creation, agent start, naming, prompt send, manifest save",
      "category": "team",
      "permission": "write",
      "input_schema": {
        "request_id": {
          "type": "string",
          "required": true,
          "description": "Idempotency key to prevent duplicate team start"
        },
        "config_path": {
          "type": "string",
          "required": false,
          "description": "Explicit path to team config JSON"
        },
        "origin_kind": {
          "type": "string",
          "required": false,
          "description": "Override the origin agent kind (default: auto-detected from current pane)"
        },
        "kickoff_context": {
          "type": "object",
          "required": false,
          "description": "Context passed to team members (e.g. issue, base branch, work branch)"
        },
        "timeout": {
          "type": "number",
          "required": false,
          "description": "Timeout in ms for pane split, agent start, and prompt (default: 30000, max: 300000)"
        },
        "keep_on_failure": {
          "type": "boolean",
          "required": false,
          "description": "Keep created panes on start failure instead of rollback"
        },
        "grant": {
          "type": "string",
          "required": true,
          "description": "Operation permission level (read, write, sensitive-write)"
        }
      },
      "output_schema": {
        "data": {
          "type": "object",
          "properties": {
            "team_id": "string",
            "members": "array",
            "manifest_path": "string"
          }
        }
      }
    },
    {
      "name": "team.get",
      "description": "Get a single team's manifest and current state",
      "category": "team",
      "permission": "read",
      "input_schema": {
        "team_id": {
          "type": "string",
          "required": true,
          "description": "Team ID to retrieve"
        }
      },
      "output_schema": {
        "data": {
          "type": "object",
          "properties": {
            "team_id": "string",
            "workspace_id": "string",
            "members": "array",
            "created_at": "string",
            "status": "string",
            "kickoff_context": "object"
          }
        }
      }
    },
    {
      "name": "team.stop",
      "description": "Stop all members of a team and remove the manifest",
      "category": "team",
      "permission": "sensitive-write",
      "input_schema": {
        "team_id": {
          "type": "string",
          "required": true,
          "description": "Team ID to stop"
        },
        "grant": {
          "type": "string",
          "required": true,
          "description": "Operation permission level (read, write, sensitive-write)"
        }
      },
      "output_schema": {
        "data": {
          "type": "object",
          "properties": {
            "team_id": "string",
            "stopped_members": "array"
          }
        }
      }
    },
    {
      "name": "member.prompt",
      "description": "Send a prompt to a team member. Activates deferred members on first call.",
      "category": "member",
      "permission": "write",
      "input_schema": {
        "request_id": {
          "type": "string",
          "required": true,
          "description": "Idempotency key to prevent duplicate prompt delivery"
        },
        "team_id": {
          "type": "string",
          "required": true,
          "description": "Team ID the member belongs to"
        },
        "role": {
          "type": "string",
          "required": true,
          "description": "Member role to prompt (impl, review, pr-fix, etc.)"
        },
        "text": {
          "type": "string",
          "required": true,
          "description": "Prompt text to send"
        },
        "timeout": {
          "type": "number",
          "required": false,
          "description": "Prompt timeout in ms (default: 30000, max: 300000)"
        },
        "grant": {
          "type": "string",
          "required": true,
          "description": "Operation permission level (read, write, sensitive-write)"
        }
      },
      "output_schema": {
        "data": {
          "type": "object",
          "properties": {
            "team_id": "string",
            "role": "string",
            "pane_id": "string",
            "agent_name": "string",
            "prompt_sent": "boolean"
          }
        }
      }
    },
    {
      "name": "member.wait",
      "description": "Wait for a team member agent to finish processing",
      "category": "member",
      "permission": "read",
      "input_schema": {
        "team_id": {
          "type": "string",
          "required": true,
          "description": "Team ID the member belongs to"
        },
        "role": {
          "type": "string",
          "required": true,
          "description": "Member role to wait for"
        },
        "timeout": {
          "type": "number",
          "required": false,
          "description": "Wait timeout in ms (default: 60000, max: 60000)"
        }
      },
      "output_schema": {
        "data": {
          "type": "object",
          "properties": {
            "team_id": "string",
            "role": "string",
            "agent_name": "string",
            "agent_status": "string"
          }
        }
      }
    },
    {
      "name": "member.read",
      "description": "Read output from a team member agent",
      "category": "member",
      "permission": "read",
      "input_schema": {
        "team_id": {
          "type": "string",
          "required": true,
          "description": "Team ID the member belongs to"
        },
        "role": {
          "type": "string",
          "required": true,
          "description": "Member role to read from"
        },
        "lines": {
          "type": "number",
          "required": false,
          "description": "Number of lines to read (default: 200)"
        }
      },
      "output_schema": {
        "data": {
          "type": "object",
          "properties": {
            "team_id": "string",
            "role": "string",
            "agent_name": "string",
            "output": "string"
          }
        }
      }
    },
    {
      "name": "member.close",
      "description": "Close a team member's pane and free resources. Idempotent.",
      "category": "member",
      "permission": "sensitive-write",
      "input_schema": {
        "team_id": {
          "type": "string",
          "required": true,
          "description": "Team ID the member belongs to"
        },
        "role": {
          "type": "string",
          "required": true,
          "description": "Member role to close"
        },
        "grant": {
          "type": "string",
          "required": true,
          "description": "Operation permission level (read, write, sensitive-write)"
        }
      },
      "output_schema": {
        "data": {
          "type": "object",
          "properties": {
            "team_id": "string",
            "role": "string",
            "closed": "boolean"
          }
        }
      }
    }
  ]
}
