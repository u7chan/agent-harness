      "output_schema": {
        "data": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": "integer",
              "number": "integer",
              "title": "string",
              "state": "string",
              "html_url": "string",
              "user": { "login": "string" },
