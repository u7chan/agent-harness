    {
      "name": "issue.list",
      "description": "List repository issues",
      "category": "issue",
      "permission": "read",
      "requires_auth": true,
      "input_schema": {
        "state": {
          "type": "string",
          "required": false,
          "description": "Filter by state (open, closed, all, default: open)"
